post_install() {
  cat <<'EOF'
Moon Bridge has been installed as /usr/bin/moonbridge.

Default config path:
  ~/moonbridge/config.yml

For a local starter config:
  mkdir -p ~/moonbridge
  cp /usr/share/doc/moon-bridge/config.local.yml ~/moonbridge/config.yml
  moonbridge

Replace provider settings before sending real upstream requests.
EOF
}

post_upgrade() {
  post_install
}
